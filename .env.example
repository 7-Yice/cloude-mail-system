# Account and transport. Use an app password, never your normal account password.
MAIL_USER=your-account@example.com
GMAIL_APP_PASSWORD=replace-me
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Local state. Keep this directory private and out of Git.
CLOUDE_MAIL_RUNTIME_DIR=/home/you/.config/cloude-mail-system
CLOUDE_MAIL_PASSWORD_FILE=/home/you/.config/cloude-mail-system/mail-password
CLOUDE_MAIL_IDENTITY_FILE=/home/you/.config/cloude-mail-system/correspondence-identities.json
CLOUDE_MAIL_COMMITMENT_LEDGER=/home/you/.config/cloude-mail-system/mail-commitments.json
CLOUDE_RUNTIME_INBOX=/path/to/your/runtime_inbox.py

# Optional Ombre integration used for constellation validation, summaries,
# the one-step reply note, and conservative promise-candidate extraction.
OMBRE_BUCKETS_DIR=/home/you/ombre-brain/buckets
OMBRE_ENV_FILE=/home/you/ombre-brain/.env
OMBRE_MCP_URL=http://127.0.0.1:18001/mcp
OMBRE_MCP_TOKEN=replace-me
OMBRE_CONTAINER=ombre-brain
